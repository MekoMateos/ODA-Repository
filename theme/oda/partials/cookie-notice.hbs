{{!-- Information notice, not a consent banner: ODA uses only strictly necessary cookies
      (member sign-in) and cookieless analytics, which need no consent under GDPR/ePrivacy.
      If a tracking or advertising tool is ever added, replace this with a real opt-in banner. --}}
<div class="cookie-note" id="cookie-note" role="region" aria-label="{{t "Cookies"}}" hidden>
    <p>{{t "We use only the cookies needed for signing in. No ads, no tracking."}} <a href="{{@site.url}}/cookies/">{{t "Cookie policy"}}</a></p>
    <button type="button" class="btn btn-small" data-cookie-ok>{{t "OK"}}</button>
</div>
