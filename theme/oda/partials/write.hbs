{{!-- The composer at the top of the feed: "Shkruaj artikullin tënd".
     It opens to two paths: write once without an account (the piece goes to the editors' queue in Redaksia,
     nothing is published from here), or sign in as an ODA author. Links: /#shkruaj opens it, /#shkruaj-nje-here opens the sheet.
     Text only for now: there is no control here that does nothing. --}}
<section class="write composer" id="shkruaj" aria-labelledby="write-h" data-write>
    <div class="write-bar">
        <span class="avatar avatar-blank composer-ava" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M8 2.5h8l2.6 7.2L12 22 5.4 9.7z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M12 22v-8.6" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="11.6" r="1.5" fill="currentColor"/></svg></span>
        <div class="write-text">
            <h2 class="write-h" id="write-h">{{t "In the oda, the floor goes to the guest."}}</h2>
            <p class="write-dek">{{t "Have a story nobody has told, a document that should be read, or an argument with no place elsewhere? Write it. The editors read it carefully, check it and get back to you."}}</p>
        </div>
        <button class="write-go" type="button" aria-expanded="false" aria-controls="write-panel" data-write-toggle>
            <span>{{t "Write your article"}}</span>
            <svg class="write-chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4.5 6 8.5l4-4" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        </button>
    </div>

    <div class="write-panel" id="write-panel" data-write-panel>
        <div class="write-inner">
            <div class="write-doors" data-write-doors>
                <div class="door door-once">
                    <p class="door-tag">{{t "No account"}}</p>
                    <h3>{{t "Write once"}}</h3>
                    <p class="door-text">{{t "One piece, no sign-up. Send it from this page and the editors review it before anyone else reads it."}}</p>
                    <button class="door-btn" type="button" data-write-open>{{t "Open the sheet"}}</button>
                    <noscript><p class="door-note">{{t "The sheet needs JavaScript."}}</p></noscript>
                </div>
                <div class="door door-login">
                    <p class="door-tag">{{t "For ODA authors"}}</p>
                    <h3>{{t "Sign in to your account"}}</h3>
                    <p class="door-text">{{t "Write at the editors' desk, submit for review and follow every step to publication."}}</p>
                    <a class="door-btn door-btn-line" href="{{@site.url}}/ghost/">{{t "Sign in"}}</a>
                    <a class="door-more" href="{{@site.url}}/behu-autor/">{{t "Want to write regularly? Become an ODA author"}}</a>
                </div>
            </div>

            <form class="sheet" data-write-form hidden novalidate aria-labelledby="sheet-h">
                <div class="sheet-top">
                    <button class="sheet-back" type="button" data-write-back><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M10 6H3M6 3 3 6l3 3" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>{{t "Back"}}</button>
                    <h3 class="sheet-h" id="sheet-h">{{t "Write once"}}</h3>
                    <p class="sheet-saved" data-write-saved>{{t "Your draft stays on this device until you send it."}}</p>
                </div>
                <p class="sheet-restored" data-write-restored hidden>{{t "We brought back the draft you started on this device."}} <button type="button" data-write-clear>{{t "Start over"}}</button></p>
                <div class="sheet-grid">
                    <div class="sheet-page">
                        <label class="sr-only" for="sheet-title">{{t "Title"}}</label>
                        <textarea class="sheet-title" id="sheet-title" name="title" rows="1" maxlength="160" required placeholder="{{t "Title: one sentence that says the heart of it"}}" data-grow></textarea>
                        <label class="sr-only" for="sheet-body">{{t "Your piece"}}</label>
                        <textarea class="sheet-body" id="sheet-body" name="body" required placeholder="{{t "Start here. Write as if you were telling it to a friend in the oda: clearly, with facts and without noise."}}" aria-describedby="sheet-count" data-grow></textarea>
                        <p class="sheet-count" id="sheet-count" data-write-count></p>
                    </div>
                    <div class="sheet-side">
                        <label>{{t "Section"}}
                            <select name="section">
                                <option value="">{{t "Let the editors choose"}}</option>
                                <option value="politike">Politikë</option><option value="ekonomi">Ekonomi</option><option value="drejtesi">Drejtësi</option>
                                <option value="shoqeri">Shoqëri</option><option value="kerkim">Kërkim</option><option value="arti">Arti</option><option value="opinion">Opinion</option>
                            </select>
                        </label>
                        <label>{{t "Sources"}}
                            <textarea name="sources" rows="4" maxlength="5000" placeholder="https://" aria-describedby="sheet-src-help"></textarea>
                            <span class="sheet-help" id="sheet-src-help">{{t "Every fact has a source. One link or document per line."}}</span>
                        </label>
                        <label>{{t "First and last name"}}
                            <input name="author_name" maxlength="80" required autocomplete="name" aria-describedby="sheet-name-help">
                            <span class="sheet-help" id="sheet-name-help">{{t "Shown as the author if the piece is published."}}</span>
                        </label>
                        <label>{{t "Email"}}
                            <input name="email" type="email" maxlength="254" required autocomplete="email" inputmode="email" aria-describedby="sheet-email-help">
                            <span class="sheet-help" id="sheet-email-help">{{t "Only so the editors can reply. Never shown, never used for anything else."}}</span>
                        </label>
                        <label>{{t "Note to the editors (optional)"}}
                            <textarea name="note" rows="2" maxlength="1000" placeholder="{{t "E.g. any link you have to the subject, or if you need a pen name and why."}}"></textarea>
                        </label>
                        <label class="sheet-check"><input type="checkbox" name="consent" value="1" required> <span>{{t "The piece is mine and original. I accept that the editors check and edit it, and I know it may not be published."}}</span></label>
                        <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off"></label></div>
                        {{#if @custom.turnstile_site_key}}<div class="write-turnstile" data-sitekey="{{@custom.turnstile_site_key}}"></div>{{/if}}
                        <button class="btn sheet-send" type="submit">{{t "Send to the editors"}}</button>
                        <p class="sheet-msg" role="status" data-write-msg></p>
                        <p class="sheet-fine">{{t "How we review pieces:"}} <a href="{{@site.url}}/politika-editoriale/">{{t "Editorial policy"}}</a>. {{t "What we keep and for how long:"}} <a href="{{@site.url}}/privatesia/">{{t "Privacy"}}</a>.</p>
                    </div>
                </div>
            </form>

            <div class="sheet-done" data-write-done hidden tabindex="-1">
                <svg class="seal" width="56" height="56" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 2 46 24 24 46 2 24z" fill="#E41E20"/><path d="M24 12.5 35.5 24 24 35.5 12.5 24z" fill="#000"/><path d="M24 19 29 24l-5 5-5-5z" fill="#E41E20"/></svg>
                <h3>{{t "Your piece has reached the oda."}}</h3>
                <p>{{t "Thank you. An editor reads it within 10 working days and writes to you by email, even when the answer is no."}}</p>
            </div>
        </div>
    </div>
</section>
