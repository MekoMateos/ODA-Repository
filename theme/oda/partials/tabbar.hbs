{{!-- Phones only: the five places a reader goes most. --}}
<nav class="tabbar" aria-label="{{t "Quick navigation"}}">
    <a class="tab" href="{{@site.url}}"{{#is "home"}} aria-current="page"{{/is}}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 11 12 3l9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" stroke-linejoin="round"/></svg>
        <span>{{t "Front"}}</span>
    </a>
    <button class="tab" type="button" data-ghost-search>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span>{{t "Search"}}</span>
    </button>
    <a class="tab tab-post" href="{{@site.url}}/#shkruaj" data-post-link>
        <i aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></i>
        <span>{{t "Post"}}</span>
    </a>
    <a class="tab" href="{{@site.url}}/tag/protesta/"{{#is "tag"}}{{#tag}}{{#match slug "protesta"}} aria-current="page"{{/match}}{{/tag}}{{/is}}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3" fill="currentColor"/><path d="M6.3 6.3a8 8 0 0 0 0 11.4M17.7 6.3a8 8 0 0 1 0 11.4" stroke-linecap="round"/></svg>
        {{#get "posts" filter="tag:hash-live" limit="1" fields="id" as |live|}}{{#if live}}<i class="tab-dot" aria-hidden="true"></i>{{/if}}{{/get}}
        <span>{{t "Live"}}</span>
    </a>
    {{#if @site.members_enabled}}
    <a class="tab" href="{{#if @member}}#/portal/account{{else}}#/portal/signin{{/if}}">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c.8-4.2 4-6.5 8-6.5s7.2 2.3 8 6.5" stroke-linecap="round"/></svg>
        <span>{{t "Account"}}</span>
    </a>
    {{/if}}
</nav>
