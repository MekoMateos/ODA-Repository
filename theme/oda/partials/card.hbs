{{!-- Article card. size: "hero" | "wide" | (default grid card) --}}
<article class="card card-{{#if size}}{{size}}{{else}}std{{/if}} {{post_class}}">
    {{#if feature_image}}
    <a class="card-img" href="{{url}}" tabindex="-1" aria-hidden="true">
        <img srcset="{{img_url feature_image size="s"}} 480w, {{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w"
             sizes="(min-width: 960px) {{#match size "hero"}}60vw{{else}}{{#match size "wide"}}50vw{{else}}32vw{{/match}}{{/match}}, 100vw"
             src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">
    </a>
    {{/if}}
    <div class="card-body">
        {{#match size "hero"}}{{#primary_tag}}<a class="card-kicker" href="{{url}}">{{name}}</a>{{/primary_tag}}{{/match}}
        <div class="card-top">
            <h3 class="card-title"><a href="{{url}}">{{title}}</a></h3>
            <a class="card-go" href="{{url}}" tabindex="-1" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6h7M6 3l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a>
        </div>
        {{> "proof"}}
        <p class="card-excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt words="26"}}{{/if}}</p>
        <p class="card-meta">
            <span class="card-author">{{authors separator=", " autolink="false"}}</span>
            <span class="card-stats"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM"}}</time>{{#if @site.comments_enabled}}{{comment_count empty="" singular=(t "comment") plural=(t "comments") class="card-comments"}}{{/if}}</span>
        </p>
    </div>
</article>
