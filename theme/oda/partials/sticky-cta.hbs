{{!-- Phones only: slim subscribe bar. Hidden while the subscribe block or pop-up is on screen, and once dismissed. --}}
<div class="sticky-cta" id="sticky-cta" hidden>
    <span>{{t "ODA in your inbox, free"}}</span>
    <a class="btn" href="#/portal/signup">{{t "Subscribe"}}</a>
    <button type="button" class="sticky-x" data-cta-close aria-label="{{t "Close"}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
    </button>
</div>
