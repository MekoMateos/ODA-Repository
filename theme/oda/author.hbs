{{!< default}}
<section class="listing wrap">
    {{#author}}
    <header class="profile">
        {{#if profile_image}}<img class="avatar avatar-l" src="{{img_url profile_image size="m"}}" alt="">{{/if}}
        <div class="profile-text">
            <h1 class="listing-title">{{name}}</h1>
            {{#if bio}}<p class="listing-dek">{{bio}}</p>{{/if}}
            <p class="profile-links">
                {{#if location}}<span>{{location}}</span>{{/if}}
                {{#if website}}<a href="{{website}}" rel="me noopener">{{t "Website"}}</a>{{/if}}
                {{#if twitter}}<a href="{{social_url type="twitter"}}" rel="me noopener">X</a>{{/if}}
            </p>
            {{#if @site.members_enabled}}<a class="btn" href="#/portal/signup">{{t "Follow {name} by email" name=name}}</a>{{/if}}
        </div>
    </header>
    {{/author}}
    <h2 class="rail-title">{{t "Archive"}}</h2>
    <div class="rail-grid">
        {{#foreach posts}}{{> "card"}}{{/foreach}}
    </div>
    {{pagination}}
</section>
