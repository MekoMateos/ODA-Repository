{{!< default}}
<div class="feed-wrap wrap">
    {{> "rail-left"}}
    <div class="feed">
        <div class="feed-part fp-a">
            <header class="feed-head"><h1 class="feed-title">{{t "All articles"}}</h1></header>
            <div class="feed-list" data-feed-list>{{#foreach posts}}{{> "card"}}{{/foreach}}</div>
            {{pagination}}
        </div>
    </div>
    {{> "rail-right"}}
</div>
