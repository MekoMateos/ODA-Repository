<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    <script>document.documentElement.classList.add("js")</script>
    <link rel="preload" href="{{asset "fonts/barlow-condensed-latin-700-normal.woff2"}}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{asset "fonts/familjen-grotesk-latin-wght-normal.woff2"}}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{asset "css/oda.css"}}">
    <meta name="theme-color" content="#000000">
    {{{block "head"}}}
    {{ghost_head}}
</head>
<body class="{{body_class}}">
<a class="skip" href="#main">{{t "Skip to content"}}</a>

<header class="site-head">
    <nav class="section-bar" aria-label="{{t "Sections"}}">
        {{navigation}}
    </nav>
    <div class="head-row">
        <a class="logo" href="{{@site.url}}" aria-label="{{@site.title}}">{{#if @site.logo}}<img src="{{@site.logo}}" alt="{{@site.title}}">{{else}}<svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" fill="#E41E20"/><path d="M7 7H25V25H18V21H21V11H11V21H14V25H7Z" fill="#fff"/></svg><span>ODA</span>{{/if}}</a>
        {{#is "post"}}{{#post}}{{#primary_tag}}<a class="head-section" href="{{url}}">{{name}}</a>{{/primary_tag}}{{/post}}{{/is}}
        <div class="head-actions">
            {{#if @custom.english_section_path}}<a class="head-link hide-s" href="{{@custom.english_section_path}}" hreflang="en">English</a>{{/if}}
            {{#if @site.members_enabled}}
                <a class="head-link hide-s" href="#/portal/signup">{{t "Newsletter"}}</a>
                {{#if @member}}
                    <a class="pill" href="#/portal/account">{{t "Account"}}</a>
                {{else}}
                    <a class="pill" href="#/portal/signup">{{t "Subscribe"}}</a>
                    <a class="head-link" href="#/portal/signin">{{t "Sign in"}}</a>
                {{/if}}
            {{/if}}
            <button class="icon-btn" data-ghost-search aria-label="{{t "Search"}}">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            </button>
        </div>
    </div>
</header>

<main id="main">
{{> "breadcrumbs"}}
{{{body}}}
</main>

<footer class="site-foot">
    <div class="foot-mark" aria-hidden="true">ODA</div>
    <div class="foot-row">
        <nav aria-label="{{t "About ODA"}}">{{navigation type="secondary"}}</nav>
        <p class="foot-line">{{t "Independent publishing. Every fact with a source."}}</p>
        <p class="foot-copy">&copy; {{date format="YYYY"}} {{@site.title}}</p>
    </div>
</footer>

{{#if @site.members_enabled}}{{#unless @member}}{{> "newsletter-popup"}}{{> "sticky-cta"}}{{/unless}}{{/if}}
{{#if @custom.show_cookie_notice}}{{> "cookie-notice"}}{{/if}}

<script src="{{asset "js/oda.js"}}" defer></script>
{{ghost_foot}}
</body>
</html>
