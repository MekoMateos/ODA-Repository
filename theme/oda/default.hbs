<!DOCTYPE html>
<html lang="{{@site.locale}}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>
    <link rel="preload" href="{{asset "fonts/familjen-grotesk-latin-wght-normal.woff2"}}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{asset "fonts/source-serif-4-latin-opsz-normal.woff2"}}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{asset "css/oda.css"}}">
    {{ghost_head}}
</head>
<body class="{{body_class}}">
<a class="skip" href="#main">{{t "Skip to content"}}</a>

<header class="masthead">
    <div class="masthead-top wrap">
        <a class="wordmark" href="{{@site.url}}" aria-label="{{@site.title}}">
            {{#if @site.logo}}<img src="{{@site.logo}}" alt="{{@site.title}}">{{else}}oda{{/if}}
        </a>
        <div class="masthead-side">
            <p class="tagline">{{@custom.tagline}}</p>
            <div class="masthead-actions">
                <a class="lang" href="{{@custom.english_section_path}}" hreflang="en">English</a>
                <button class="icon-btn" data-ghost-search aria-label="{{t "Search"}}">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                </button>
                {{#if @site.members_enabled}}
                    {{#if @member}}
                        <a class="btn btn-quiet" href="#/portal/account">{{t "Account"}}</a>
                    {{else}}
                        <a class="btn btn-quiet" href="#/portal/signin">{{t "Sign in"}}</a>
                        <a class="btn" href="#/portal/signup">{{t "Subscribe"}}</a>
                    {{/if}}
                {{/if}}
            </div>
        </div>
    </div>
    <nav class="sections wrap" aria-label="{{t "Sections"}}">
        {{navigation}}
    </nav>
</header>

<main id="main">
{{{body}}}
</main>

<footer class="site-foot">
    <div class="wrap foot-grid">
        <div>
            <p class="foot-mark">oda</p>
            <p class="foot-line">{{t "Independent publishing. Every fact with a source."}}</p>
        </div>
        <nav aria-label="{{t "About ODA"}}">
            {{navigation type="secondary"}}
        </nav>
        {{#if @site.members_enabled}}
        <div>
            <p class="foot-head">{{t "Newsletter"}}</p>
            <p class="foot-line">{{t "Pick the authors and topics you want by email."}}</p>
            <a class="btn" href="#/portal/signup">{{t "Subscribe"}}</a>
        </div>
        {{/if}}
    </div>
    <div class="wrap foot-base">
        <span>&copy; {{date format="YYYY"}} {{@site.title}}</span>
        <a href="{{@site.url}}/korrigjimet/">{{t "Corrections"}}</a>
        <a href="{{@site.url}}/transparenca/">{{t "Transparency"}}</a>
    </div>
</footer>

<script src="{{asset "js/oda.js"}}" defer></script>
{{ghost_foot}}
</body>
</html>
