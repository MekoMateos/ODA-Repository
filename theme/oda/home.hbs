{{!< default}}
<h1 class="sr-only">{{@site.title}}: {{@site.description}}</h1>

{{!-- Lead story: the featured post, or the newest one --}}
<section class="hero">
    {{#get "posts" filter="featured:true+tag:-{{@custom.takes_tag}}" limit="1" include="authors,tags" as |lead|}}
        {{#if lead}}
            {{#foreach lead}}{{> "card" size="hero"}}{{/foreach}}
        {{else}}
            {{#get "posts" filter="tag:-{{@custom.takes_tag}}" limit="1" include="authors,tags" as |first|}}
                {{#foreach first}}{{> "card" size="hero"}}{{/foreach}}
            {{/get}}
        {{/if}}
    {{/get}}
</section>

<section class="grid grid-3 latest" aria-label="{{t "Latest"}}">
    {{#get "posts" filter="featured:false+tag:-{{@custom.takes_tag}}+tag:-rastet+tag:-arti" limit="6" include="authors,tags" as |latest|}}
        {{#foreach latest}}{{> "card"}}{{/foreach}}
    {{/get}}
</section>

{{!-- Short takes from the editors --}}
{{#get "posts" filter="tag:{{@custom.takes_tag}}" limit="3" include="authors" as |takes|}}
{{#if takes}}
<section class="takes" aria-labelledby="takes-h">
    <div class="takes-head">
        {{#foreach takes limit="1"}}<span class="date-tag"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time></span>{{/foreach}}
        <h2 id="takes-h">{{t "Short takes from ODA"}}</h2>
        <a class="more" href="{{@site.url}}/tag/{{@custom.takes_tag}}/">{{t "All takes"}}</a>
    </div>
    <div class="grid grid-3 takes-grid">
        {{#foreach takes}}
        <article class="take">
            <h3><a href="{{url}}">{{title}}</a></h3>
            <p class="take-by">{{#primary_author}}{{#if profile_image}}<img class="avatar avatar-s" src="{{img_url profile_image size="s"}}" alt="">{{/if}}<span>{{name}}</span>{{/primary_author}}</p>
            <div class="take-text">{{excerpt words="70"}}</div>
            <a class="take-more" href="{{url}}">{{t "Read the take"}}</a>
        </article>
        {{/foreach}}
    </div>
</section>
{{/if}}
{{/get}}

{{!-- Reader poll: filled in by oda.js from Redaksia; stays hidden when no poll is open --}}
<section class="poll-band" data-poll-home hidden aria-labelledby="poll-band-h">
    <div class="poll-band-head"><h2 id="poll-band-h">{{t "Reader poll"}}</h2><a class="more" href="{{@site.url}}/sondazhe/">{{t "All polls"}}</a></div>
    <div class="poll-slot" data-poll-slot></div>
</section>

{{!-- Case studies: investigations followed to a result --}}
{{#get "posts" filter="tag:rastet" limit="3" include="authors,tags" as |cases|}}
{{#if cases}}
<section class="impact" aria-labelledby="impact-h">
    <div class="topic-head"><h2 id="impact-h">{{t "Impact"}}</h2><p class="impact-dek">{{t "What happened after we published."}}</p><a class="more" href="{{@site.url}}/tag/rastet/">{{t "All cases"}}</a></div>
    <div class="cases">{{#foreach cases}}{{> "case-card"}}{{/foreach}}</div>
</section>
{{/if}}
{{/get}}

{{!-- Original research --}}
{{#get "posts" filter="tag:kerkim" limit="3" include="authors,tags" as |papers|}}
{{#if papers}}
<section class="research-band" aria-labelledby="research-h">
    <div class="topic-head"><h2 id="research-h"><a href="{{@site.url}}/tag/kerkim/">{{t "Research"}}</a></h2><p class="impact-dek">{{t "Original studies, with the method and the data."}}</p><a class="more" href="{{@site.url}}/tag/kerkim/">{{t "All research"}}</a></div>
    <ul class="papers">{{#foreach papers}}{{> "paper"}}{{/foreach}}</ul>
</section>
{{/if}}
{{/get}}

{{!-- Category sections, each with its own colour --}}
{{#get "tags" filter="slug:[{{@custom.home_topics}}]" limit="6" as |topics|}}
{{#foreach topics}}
<section class="topic topic-{{slug}}" aria-labelledby="topic-{{slug}}">
    <div class="topic-head"><h2 id="topic-{{slug}}"><a href="{{url}}">{{name}}</a></h2></div>
    {{#get "posts" filter="tag:{{slug}}+tag:-{{@custom.takes_tag}}+featured:false" limit="4" include="authors,tags" as |tposts|}}
        <div class="topic-lead">{{#foreach tposts limit="1"}}{{> "card" size="wide"}}{{/foreach}}</div>
        <div class="grid grid-3 topic-grid">
            {{#foreach tposts from="2" limit="2"}}{{> "card"}}{{/foreach}}
            <a class="topic-more" href="{{../url}}"><span>{{t "Read more {name}" name=../name}}</span><svg width="14" height="14" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6h7M6 3l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></a>
        </div>
    {{/get}}
</section>
{{/foreach}}
{{/get}}

{{!-- Art: a scrolling gallery wall, images uncropped --}}
{{#get "posts" filter="tag:arti" limit="8" as |works|}}
{{#if works}}
<section class="art-band" aria-labelledby="art-h">
    <div class="topic-head"><h2 id="art-h"><a href="{{@site.url}}/tag/arti/">{{t "Art"}}</a></h2><a class="more" href="{{@site.url}}/tag/arti/">{{t "Open the gallery"}}</a></div>
    <ul class="art-wall">
        {{#foreach works}}
        <li><a href="{{url}}">
            {{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">{{/if}}
            <span class="art-cap"><span class="art-title">{{title}}</span><span class="art-by">{{authors separator=", " autolink="false"}}</span></span>
        </a></li>
        {{/foreach}}
    </ul>
</section>
{{/if}}
{{/get}}

{{#if @custom.show_authors_on_home}}
<section class="writers" aria-labelledby="writers-h">
    <div class="topic-head"><h2 id="writers-h">{{t "Writers"}}</h2><a class="more" href="{{@site.url}}/autoret/">{{t "All writers"}}</a></div>
    <ul class="writer-strip">
    {{#get "authors" limit="8" include="count.posts" order="count.posts desc" as |writers|}}
        {{#foreach writers}}{{#if count.posts}}<li>{{> "author-chip"}}</li>{{/if}}{{/foreach}}
    {{/get}}
    </ul>
</section>
{{/if}}

{{> "subscribe"}}
