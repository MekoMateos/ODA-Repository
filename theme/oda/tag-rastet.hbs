{{!< default}}
{{!-- Case studies ("Rastet"): investigations followed through to a result.
      Each post: custom excerpt = the result in one sentence; body sections Problemi / Çfarë bëmë / Rezultati / Burimet. --}}
{{#tag}}{{> "channel-head" total=../pagination.total}}{{/tag}}
<section class="listing wrap cases-page">
    <div class="cases" data-feed-list>
        {{#foreach posts}}{{> "case-card"}}{{/foreach}}
    </div>
    {{pagination}}
</section>
