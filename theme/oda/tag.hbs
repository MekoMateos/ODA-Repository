{{!< default}}
{{!-- A channel: the topic's colour on top, its posts below --}}
{{#tag}}{{> "channel-head" total=../pagination.total}}{{/tag}}
<div class="feed-wrap wrap">
    {{> "rail-left"}}
    <div class="feed">
        <div class="feed-part fp-a">
            <div class="feed-list" data-feed-list>{{#foreach posts}}{{> "card"}}{{/foreach}}</div>
            {{pagination}}
        </div>
    </div>
    {{> "rail-right"}}
</div>
