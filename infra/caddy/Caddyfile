{
	# Cloudflare terminates public TLS; Caddy uses a Cloudflare Origin certificate
	# so traffic is encrypted end to end ("Full (strict)" in Cloudflare SSL settings).
	auto_https off
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
		-X-Powered-By
	}
}

# Public site: readers, members, newsletters.
{$DOMAIN}:443 {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	import security_headers
	encode zstd gzip

	# The admin lives only on the admin domain (protected by Cloudflare Access).
	@admin path /ghost /ghost/*
	handle @admin {
		@notapi not path /ghost/api/content/* /ghost/api/members/*
		redir @notapi https://{$ADMIN_DOMAIN}{uri} 302
		reverse_proxy ghost:2368
	}

	handle {
		reverse_proxy ghost:2368
	}
}

# Admin domain: editors and staff only. Cloudflare Access sits in front of it.
{$ADMIN_DOMAIN}:443 {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	import security_headers
	header X-Robots-Tag "noindex, nofollow"

	# Editorial dashboard (ODA Redaksia). Cloudflare Access protects the whole admin domain;
	# the dashboard also verifies the Access token itself.
	handle /redaksia* {
		reverse_proxy redaksia:3000
	}

	@nonadmin not path /ghost /ghost/* /content/images/* /assets/* /public/* /redaksia*
	redir @nonadmin https://{$DOMAIN}{uri} 302

	reverse_proxy ghost:2368
}

:80 {
	redir https://{host}{uri} 301
}
