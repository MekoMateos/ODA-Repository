# Copy to infra/.env on the server only. Never commit the real file.
# Generate passwords with: openssl rand -base64 32

DOMAIN=oda.example.org
ADMIN_DOMAIN=admin.oda.example.org
GHOST_VERSION=6-alpine

MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# Mailgun, EU region, SMTP credentials for transactional mail
MAILGUN_SMTP_USER=postmaster@mg.oda.example.org
MAILGUN_SMTP_PASSWORD=change-me

# Off-site encrypted backups (restic -> Backblaze B2, EU region)
RESTIC_REPOSITORY=s3:s3.eu-central-003.backblazeb2.com/oda-backups
RESTIC_PASSWORD=change-me-and-store-in-the-password-manager
AWS_ACCESS_KEY_ID=b2-key-id
AWS_SECRET_ACCESS_KEY=b2-application-key

# Uptime / backup alerts (e.g. a healthchecks.io ping URL)
HEALTHCHECK_URL=

# ODA Redaksia (editorial dashboard)
# Ghost Admin > Settings > Integrations > "ODA Redaksia" > Admin API key
REDAKSIA_GHOST_ADMIN_API_KEY=
# openssl rand -base64 48
REDAKSIA_SESSION_SECRET=
# Cloudflare Zero Trust team domain, e.g. oda.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# "Application Audience (AUD) Tag" of the Access application for the admin domain
REDAKSIA_CF_ACCESS_AUD=
# First admin; adds everyone else from the Ekipi page
REDAKSIA_BOOTSTRAP_ADMIN_EMAIL=
# Keys the reader votes are hashed with (openssl rand -base64 48). Never change it while a poll is open,
# or readers who already voted could vote again. If empty, REDAKSIA_SESSION_SECRET is used.
REDAKSIA_COMMUNITY_SECRET=
# Optional: Cloudflare Turnstile secret for the public forms (resource suggestions and guest pieces); the site key goes in Ghost > Design > Theme settings
TURNSTILE_SECRET=
# Ghost staff user that accepted guest pieces are filed under (e.g. a Contributor named "Shkrime të ftuara").
# The guest's own name is shown on the article. If empty, Ghost files them under the site owner.
REDAKSIA_GUEST_AUTHOR_EMAIL=
